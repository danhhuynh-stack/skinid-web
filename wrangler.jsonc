{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skinid-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-20",
  "placement": {
    "region": "gcp:us-central1"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
