{
  "name": "skinid-storefront",
  "private": true,
  "scripts": {
    "generate:server-catalog": "node scripts/generate-server-catalog.mjs",
    "predev": "node scripts/restore-source-html.mjs",
    "prebuild": "node scripts/restore-source-html.mjs && npm run generate:server-catalog",
    "build": "vite build",
    "postbuild": "node scripts/prepare-gh-pages.mjs",
    "preview": "vite preview",
    "dev": "vite",
    "dev:cloudflare": "npm run build && wrangler dev",
    "deploy": "npm run test:all && wrangler deploy",
    "test": "node --test tests/*.test.js",
    "test:all": "npm test && npm run build",
    "audit:catalog": "node scripts/audit-catalog.js",
    "firestore:import-products": "node scripts/import-products-to-firestore.mjs",
    "firebase:set-admin": "node scripts/set-admin-claim.mjs",
    "firestore:deploy-rules": "npx firebase-tools@15.30.2 deploy --project skinid-official --only firestore --non-interactive"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jose": "^6.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-admin": "^14.4.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "wrangler": "^4.42.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
